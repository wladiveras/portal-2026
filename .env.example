ante# Supabase — obrigatorios para dashboard (/dashboard/**)
SUPABASE_URL=
SUPABASE_KEY=

# Somente server-side; nunca expor no cliente. Usado em handlers Nitro.
NUXT_SUPABASE_SECRET_KEY=

# Script: `npm run seed:e2e` (usa `tsx` + `e2e/seed/supabase.seed.ts`, requer SUPABASE service key)
# Opcional — sobrescreve a baseURL do Playwright
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_SEED=false
PLAYWRIGHT_SUPABASE_URL=
PLAYWRIGHT_SUPABASE_SERVICE_KEY=
PLAYWRIGHT_ADMIN_EMAIL=e2e-admin@portal.local
PLAYWRIGHT_ADMIN_PASSWORD=Admin@123456
PLAYWRIGHT_EDITOR_EMAIL=e2e-editor@portal.local
PLAYWRIGHT_EDITOR_PASSWORD=Editor@123456
PLAYWRIGHT_VIEWER_EMAIL=e2e-viewer@portal.local
PLAYWRIGHT_VIEWER_PASSWORD=Viewer@123456

# Postgres URL para Drizzle ORM/migrations (Supabase session pooler ou direct DB URL)
DATABASE_URL=
